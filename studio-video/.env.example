# Salin file ini menjadi .env lalu isi. JANGAN bagikan file .env ke siapa pun.

# ===== Claude (wajib) =====
# Buat API key di https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ===== Suara narasi (Edge TTS, gratis) =====
# Pilihan: id-ID-GadisNeural (perempuan) / id-ID-ArdiNeural (laki-laki)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+10%

# ===== YouTube =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Diisi otomatis oleh: npm run auth:youtube
YOUTUBE_REFRESH_TOKEN=
# public / unlisted / private
YOUTUBE_PRIVACY=public

# ===== TikTok =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Kosongkan di server: Studio memakai https://<domain Studio>/api/tiktok/callback.
TIKTOK_REDIRECT_URI=
# Diisi otomatis oleh tombol Hubungkan TikTok (atau npm run auth:tiktok)
TIKTOK_REFRESH_TOKEN=
# Sebelum app lolos audit TikTok hanya SELF_ONLY yang diizinkan.
# Setelah lolos: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# ===== Instagram & Facebook (Meta) =====
# Page Access Token jangka panjang (lihat README)
META_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
META_GRAPH_VERSION=v21.0
# PUBLISHED / DRAFT
FB_VIDEO_STATE=PUBLISHED

# ===== Render jarak jauh (opsional) =====
# Di SERVER: RENDER_MODE=remote agar render dikerjakan laptop render (worker).
# Kosong/local = render di komputer yang menjalankan Studio.
RENDER_MODE=local
# Token rahasia bersama server & worker (minimal 16 karakter, sama persis di kedua komputer).
WORKER_TOKEN=
# Di SERVER (opsional): IP yang didengar Studio, mis. IP VPN. Default 127.0.0.1 (hanya komputer itu).
STUDIO_HOST=
# Di LAPTOP RENDER: alamat Studio di server, dan nama laptop ini.
STUDIO_URL=http://127.0.0.1:4321
WORKER_NAME=
